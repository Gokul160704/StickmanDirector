{
  "name": "stickmandirector",
  "version": "1.0.0",
  "description": "A reusable workflow for planning 16:9 illustrated stickman story series, producing still images in Google Flow, managing storyboards in Boords, and assembling narrated videos locally with FFmpeg.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "producer:manual": "node scripts/producer-cli.mjs --manual",
    "render:stills": "node scripts/render-episode.mjs",
    "validate:episode": "node scripts/validate-episode.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gokul160704/StickmanDirector.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Gokul160704/StickmanDirector/issues"
  },
  "homepage": "https://github.com/Gokul160704/StickmanDirector#readme"
}
